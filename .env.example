# PitMate v2.0 Development Environment Variables
# Copy to .env.local or pass via --dart-define flags

# Supabase API Endpoint (Local Supabase or Cloud project)
SUPABASE_URL=http://127.0.0.1:54321

# Supabase Anonymous Client Key
SUPABASE_ANON_KEY=sb_publishable_anon_placeholder

# Local PostgreSQL Connection String (for CLI migrations/tools)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
